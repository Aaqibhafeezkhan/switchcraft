# Git profile — {{PROFILE}}
# Generated by switchcraft. Edit your config, not this file:
#   switchcraft add / link    (~/.config/switchcraft/config)
[user]
	name = {{NAME}}
	email = {{EMAIL}}
	signingkey = {{KEY}}.pub
[core]
	# The account's key is chosen here, so remotes stay plain git@github.com
	# and no ~/.ssh/config host aliases are needed.
	sshCommand = ssh -i {{KEY}} -o IdentitiesOnly=yes
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{SIGNERS}}
[credential]
	# Drop inherited helpers, then scope HTTPS credentials to this account.
	helper =
	helper = store --file={{CREDFILE}}
