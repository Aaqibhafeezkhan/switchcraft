# Source for the README demo. Record with: vhs docs/demo.tape
# https://github.com/charmbracelet/vhs
Output docs/demo.gif

Set Shell bash
Set FontSize 18
Set Width 1100
Set Height 620
Set Padding 20
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Type "cd ~/projects/work && switchcraft status"
Enter
Sleep 3s

Type "cd ~/projects/personal && switchcraft status"
Enter
Sleep 3s

Type "# nothing typed but cd. git, ssh, gh and Claude all followed."
Enter
Sleep 2.5s
